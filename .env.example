# Application Configuration
APP_ENV=development
APP_SECRET_KEY=dev-secret-key-change-in-production
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/iso_mapper
REDIS_URL=redis://redis:6379/0

# Azure OpenAI (Optional - for LLM-based transformation)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Azure Key Vault (Optional)
AZURE_KEYVAULT_URL=https://your-keyvault.vault.azure.net/

# Transformation Approach: 'rules', 'llm', or 'hybrid'
TRANSFORMATION_APPROACH=hybrid

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Phoenix Observability (Optional)
PHOENIX_HOST=phoenix
PHOENIX_PORT=6006
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
PHOENIX_PROJECT_NAME=iso-mapper

# Backend Service Port
BACKEND_PORT=8000

# Frontend Dev Server Port
FRONTEND_PORT=5173
