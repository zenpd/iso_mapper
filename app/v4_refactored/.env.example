# Application Configuration
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Transformation Configuration
TRANSFORMATION_APPROACH=hybrid
MAX_MESSAGE_SIZE=1000000
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
CACHE_ENABLED=true

# Azure OpenAI Configuration (optional, for LLM features)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_KEY=your-api-key-here
CHAT_LLM_DEPLOYMENT=your-deployment-name
CHAT_LLM_MODEL=gpt-4o
AZURE_API_VERSION=2024-02-15-preview

# Database (optional, for future persistence)
DATABASE_URL=sqlite:///./iso_mapper.db

# Azure Key Vault (optional, for production secrets)
AZURE_KEYVAULT_URL=https://your-keyvault.vault.azure.net/
AZURE_OPENAI_ENDPOINT_KV_URI=
AZURE_API_KEY_KV_URI=
